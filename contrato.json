          "status": 400
        },
        {
          "descricao": "Sem token",
          "requisicao": {
            "cursoId": 1
          },
          "resposta": {
            "erro": "Token ausente ou inválido"
          },
          "status": 401
        }
      ]
    },
    {
      "metodo": "GET",
      "caminho": "/matriculas",
      "acesso": "logado",
      "descricao": "Lista somente as matrículas do usuário autenticado.",
      "exemplos": [
        {
          "descricao": "Matrículas encontradas",
          "requisicao": null,
          "resposta": [
            {
              "id": 1,
